# Frontend Environment Variables

# URL base da API do Backend
# Use o endereço IP local ou o nome do serviço se estiver usando Docker Compose, ou a URL pública se implantado
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# URL do servidor WebSocket (geralmente o mesmo host/porta do backend)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Chaves de API de terceiros (se houver, ex: Google Maps, etc.)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

