DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=your_db_user # Substitua pelo seu usuário do SQL Server
DB_PASSWORD=your_db_password # Substitua pela sua senha do SQL Server
DB_NAME=sales_dashboard_db # Substitua pelo nome do seu banco de dados
DB_OPTIONS=encrypt=true # Ajuste conforme necessário (ex: trustServerCertificate=true para dev)

JWT_SECRET=your_jwt_secret_key # Substitua por uma chave secreta forte
JWT_EXPIRES_IN=1h

# Configurações de OAuth (Exemplo Google - substitua pelos seus dados)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Porta do Servidor Backend
PORT=3001

